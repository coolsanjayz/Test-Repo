<#
.SYNOPSIS
    Export Runtime Manager property keys from all accessible Anypoint
    business groups for a selected Hybrid environment.

.EXAMPLE
    .\getproperty.ps1 `
        -BearerToken "Bearer eyJ..." `
        -RootOrganizationId "ROOT-ORG-ID" `
        -EnvironmentName "Development"
#>

[CmdletBinding()]
param (
    [Parameter(Mandatory = $true)]
    [string]$BearerToken,

    [Parameter(Mandatory = $true)]
    [string]$RootOrganizationId,

    [Parameter(Mandatory = $true)]
    [string]$EnvironmentName,

    [Parameter(Mandatory = $false)]
    [string]$OutputCsv = ".\Anypoint-RuntimeManager-PropertyKeys.csv",

    [Parameter(Mandatory = $false)]
    [string]$ErrorCsv = ".\Anypoint-RuntimeManager-Errors.csv",

    [Parameter(Mandatory = $false)]
    [string]$BaseUrl = "https://anypoint.mulesoft.com"
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

[Net.ServicePointManager]::SecurityProtocol =
    [Net.ServicePointManager]::SecurityProtocol -bor
    [Net.SecurityProtocolType]::Tls12

$BaseUrl = $BaseUrl.TrimEnd("/")
$BearerToken = $BearerToken.Trim()

# Accept either:
#   eyJ...
# or:
#   Bearer eyJ...
if ($BearerToken -match '^(?i)Bearer\s+') {
    $BearerToken = $BearerToken -replace '^(?i)Bearer\s+', ''
}

if ([string]::IsNullOrWhiteSpace($BearerToken)) {
    throw "Bearer token cannot be empty."
}

$script:BearerToken = $BearerToken

$results = [System.Collections.Generic.List[object]]::new()
$errors = [System.Collections.Generic.List[object]]::new()

# Cache component responses because many applications use the same target.
$script:TargetPropertyCache = @{}
$script:TargetComponentIdCache = @{}


function Invoke-AnypointGet {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [string]$Uri,

        [Parameter(Mandatory = $false)]
        [hashtable]$AdditionalHeaders
    )

    $headers = @{
        Authorization = "Bearer $script:BearerToken"
        Accept        = "application/json"
    }

    if ($AdditionalHeaders) {
        foreach ($headerName in $AdditionalHeaders.Keys) {
            $headers[$headerName] = $AdditionalHeaders[$headerName]
        }
    }

    try {
        return Invoke-RestMethod `
            -Method Get `
            -Uri $Uri `
            -Headers $headers
    }
    catch {
        $statusCode = $null
        $responseText = $null

        if ($_.Exception.Response) {
            try {
                $statusCode = [int]$_.Exception.Response.StatusCode
            }
            catch {
                $statusCode = $null
            }
        }

        if ($_.ErrorDetails -and $_.ErrorDetails.Message) {
            $responseText = $_.ErrorDetails.Message
        }

        if ($statusCode -eq 401) {
            throw "401 Unauthorized for $Uri. The bearer token is invalid or expired."
        }

        if ($statusCode -eq 403) {
            throw "403 Forbidden for $Uri. Your account does not have permission."
        }

        if ($statusCode -eq 404) {
            throw "404 Not Found for $Uri."
        }

        $message = "GET failed: $Uri"

        if ($statusCode) {
            $message += " | HTTP $statusCode"
        }

        if ($responseText) {
            $message += " | Response: $responseText"
        }
        else {
            $message += " | Error: $($_.Exception.Message)"
        }

        throw $message
    }
}


function Get-UnwrappedData {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $false)]
        $Response
    )

    if ($null -eq $Response) {
        return $null
    }

    if ($Response.PSObject.Properties.Name -contains "data") {
        return $Response.data
    }

    return $Response
}


function ConvertTo-ObjectArray {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $false)]
        $Response
    )

    if ($null -eq $Response) {
        return @()
    }

    $data = Get-UnwrappedData -Response $Response

    if ($null -eq $data) {
        return @()
    }

    if (
        $data -is [System.Collections.IEnumerable] -and
        $data -isnot [string] -and
        $data -isnot [PSCustomObject] -and
        $data -isnot [System.Collections.IDictionary]
    ) {
        return @($data)
    }

    foreach ($collectionName in @(
        "items",
        "content",
        "applications",
        "environments",
        "organizations",
        "components",
        "results"
    )) {
        if ($data.PSObject.Properties.Name -contains $collectionName) {
            return @($data.$collectionName)
        }
    }

    return @($data)
}


function Test-AnypointToken {
    [CmdletBinding()]
    param()

    $null = Invoke-AnypointGet `
        -Uri "$BaseUrl/accounts/api/me"

    Write-Host "Bearer-token authentication successful."
}


function Get-OrganizationHierarchy {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [string]$OrganizationId
    )

    $response = Invoke-AnypointGet `
        -Uri "$BaseUrl/accounts/api/organizations/$OrganizationId/hierarchy"

    $hierarchy = Get-UnwrappedData -Response $response

    $organizations =
        [System.Collections.Generic.List[object]]::new()

    function Add-OrganizationNode {
        param (
            [Parameter(Mandatory = $true)]
            $Node,

            [Parameter(Mandatory = $false)]
            [string]$ParentName
        )

        if ($null -eq $Node) {
            return
        }

        $nodeId = $null
        $nodeName = $null

        foreach ($idField in @(
            "id",
            "organizationId",
            "orgId"
        )) {
            if ($Node.PSObject.Properties.Name -contains $idField) {
                $value = [string]$Node.$idField

                if (-not [string]::IsNullOrWhiteSpace($value)) {
                    $nodeId = $value
                    break
                }
            }
        }

        foreach ($nameField in @(
            "name",
            "organizationName"
        )) {
            if ($Node.PSObject.Properties.Name -contains $nameField) {
                $value = [string]$Node.$nameField

                if (-not [string]::IsNullOrWhiteSpace($value)) {
                    $nodeName = $value
                    break
                }
            }
        }

        if (-not [string]::IsNullOrWhiteSpace($nodeId)) {
            $organizations.Add(
                [PSCustomObject]@{
                    OrganizationId   = $nodeId
                    OrganizationName = $nodeName
                    ParentName       = $ParentName
                }
            )
        }

        foreach ($childField in @(
            "subOrganizations",
            "children",
            "businessGroups"
        )) {
            if ($Node.PSObject.Properties.Name -contains $childField) {
                foreach ($child in @($Node.$childField)) {
                    if ($null -ne $child) {
                        Add-OrganizationNode `
                            -Node $child `
                            -ParentName $nodeName
                    }
                }
            }
        }
    }

    foreach ($rootNode in @($hierarchy)) {
        Add-OrganizationNode -Node $rootNode
    }

    if (-not ($organizations.OrganizationId -contains $OrganizationId)) {
        try {
            $rootResponse = Invoke-AnypointGet `
                -Uri "$BaseUrl/accounts/api/organizations/$OrganizationId"

            $rootData = Get-UnwrappedData -Response $rootResponse

            $organizations.Insert(
                0,
                [PSCustomObject]@{
                    OrganizationId   = $OrganizationId
                    OrganizationName = [string]$rootData.name
                    ParentName       = $null
                }
            )
        }
        catch {
            $organizations.Insert(
                0,
                [PSCustomObject]@{
                    OrganizationId   = $OrganizationId
                    OrganizationName = "Root organization"
                    ParentName       = $null
                }
            )
        }
    }

    return @(
        $organizations |
            Group-Object OrganizationId |
            ForEach-Object {
                $_.Group | Select-Object -First 1
            } |
            Sort-Object OrganizationName
    )
}


