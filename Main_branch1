$Pat = "YOUR_PAT"
$EncodedPat = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes(":$Pat"))

$Org = "WTFC-DataManagement"
$Project = "CODE-MuleSoftESB"

$MainBranch = "main"
$TargetBranch = "release/mule-4.9.4"
$OutputFile = "release-branch-from-main-check.csv"

$Headers = @{
    Authorization = "Basic $EncodedPat"
    "Content-Type" = "application/json"
}

$RepoUri = "https://dev.azure.com/$Org/$Project/_apis/git/repositories?api-version=7.0"
$Response = Invoke-RestMethod -Uri $RepoUri -Headers $Headers -Method Get

$Results = @()

foreach ($Repo in $Response.value) {

    Write-Host "Checking: $($Repo.name)"

    try {
        $MainUri = "https://dev.azure.com/$Org/$Project/_apis/git/repositories/$($Repo.id)/refs?filter=heads/$MainBranch&api-version=7.0"
        $ReleaseUri = "https://dev.azure.com/$Org/$Project/_apis/git/repositories/$($Repo.id)/refs?filter=heads/$TargetBranch&api-version=7.0"

        $MainResponse = Invoke-RestMethod -Uri $MainUri -Headers $Headers -Method Get
        $ReleaseResponse = Invoke-RestMethod -Uri $ReleaseUri -Headers $Headers -Method Get

        if ($MainResponse.count -eq 0) {
            $Results += [PSCustomObject]@{
                RepoName = $Repo.name
                Status = "MAIN_MISSING"
                Reason = "main branch not found"
            }
            continue
        }

        if ($ReleaseResponse.count -eq 0) {
            $Results += [PSCustomObject]@{
                RepoName = $Repo.name
                Status = "RELEASE_MISSING"
                Reason = "release/mule-4.9.4 branch not found"
            }
            continue
        }

        $MainCommit = $MainResponse.value[0].objectId
        $ReleaseCommit = $ReleaseResponse.value[0].objectId

        $CommitBatchUri = "https://dev.azure.com/$Org/$Project/_apis/git/repositories/$($Repo.id)/commitsbatch?api-version=7.0"

        $Body = @{
            itemVersion = @{
                versionType = "branch"
                version = $TargetBranch
            }
            ids = @($MainCommit)
        } | ConvertTo-Json -Depth 10

        $CheckResponse = Invoke-RestMethod `
            -Uri $CommitBatchUri `
            -Headers $Headers `
            -Method Post `
            -Body $Body

        if ($CheckResponse.count -gt 0) {
            $Status = "YES_RELEASE_FROM_MAIN"
            $Reason = "release/mule-4.9.4 contains current main HEAD"
        }
        else {
            $Status = "NO_MAIN_AHEAD_OR_DIFFERENT_HISTORY"
            $Reason = "release/mule-4.9.4 does not contain current main HEAD"
        }

        $Results += [PSCustomObject]@{
            RepoName = $Repo.name
            Status = $Status
            Reason = $Reason
            MainCommit = $MainCommit
            ReleaseCommit = $ReleaseCommit
        }
    }
    catch {
        $Results += [PSCustomObject]@{
            RepoName = $Repo.name
            Status = "ERROR"
            Reason = $_.Exception.Message
        }
    }
}

$Results | Export-Csv -Path $OutputFile -NoTypeInformation

Write-Host ""
Write-Host "SUMMARY"
Write-Host "YES release from main: " `
    (($Results | Where-Object { $_.Status -eq "YES_RELEASE_FROM_MAIN" }).Count)

Write-Host "NO / main ahead:       " `
    (($Results | Where-Object { $_.Status -eq "NO_MAIN_AHEAD_OR_DIFFERENT_HISTORY" }).Count)

Write-Host "Release missing:       " `
    (($Results | Where-Object { $_.Status -eq "RELEASE_MISSING" }).Count)

Write-Host "Main missing:          " `
    (($Results | Where-Object { $_.Status -eq "MAIN_MISSING" }).Count)

Write-Host "Errors:                " `
    (($Results | Where-Object { $_.Status -eq "ERROR" }).Count)

Write-Host ""
Write-Host "CSV generated: $OutputFile"





catch {

    Write-Host ""
    Write-Host "======================================"
    Write-Host "Repo: $($Repo.name)"
    Write-Host "======================================"

    Write-Host $_.Exception.Message

    try {
        $reader = New-Object System.IO.StreamReader(
            $_.Exception.Response.GetResponseStream()
        )

        $responseBody = $reader.ReadToEnd()

        Write-Host ""
        Write-Host "Azure DevOps Response:"
        Write-Host $responseBody
    }
    catch {
        Write-Host "Could not retrieve response body."
    }

    break
}




