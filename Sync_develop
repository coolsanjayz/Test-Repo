# ============================================================
# Sync-Dev-Code-To-Deployed.ps1
#
# DEV TEST VERSION
#
# After a successful DEV deployment:
#
#   Build.SourceVersion
#          ↓
#      Dev_Code
#
# Dev_Code becomes the exact Git snapshot represented by the
# commit that produced the deployed Classic Release artifact.
#
# NO MERGE
# NO REBASE
# NO CHERRY-PICK
# ============================================================

$ErrorActionPreference = "Stop"

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

$Org = "WTFC-DataManagement"
$Project = "CODE-MuleSoftESB"

$TargetBranch = "Dev_Code"
$EnvironmentName = "DEV"

# ------------------------------------------------------------
# CLASSIC RELEASE VARIABLES
# ------------------------------------------------------------

$BuildId = "$(Build.BuildId)"
$DeployedSHA = "$(Build.SourceVersion)"
$AgentTemp = "$(Agent.TempDirectory)"

$Token = $env:SYSTEM_ACCESSTOKEN

# ------------------------------------------------------------
# VALIDATION
# ------------------------------------------------------------

if ([string]::IsNullOrWhiteSpace($Token)) {
    throw @"
SYSTEM_ACCESSTOKEN is empty.

Verify that the Classic Release Agent Job allows
scripts to access the OAuth token.
"@
}

if (
    [string]::IsNullOrWhiteSpace($BuildId) -or
    $BuildId -match '^\$\('
) {
    throw "Build.BuildId was not resolved."
}

if (
    [string]::IsNullOrWhiteSpace($DeployedSHA) -or
    $DeployedSHA -match '^\$\('
) {
    throw "Build.SourceVersion was not resolved."
}

if (
    [string]::IsNullOrWhiteSpace($AgentTemp) -or
    $AgentTemp -match '^\$\('
) {
    throw "Agent.TempDirectory was not resolved."
}

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

$Auth = [Convert]::ToBase64String(
    [Text.Encoding]::ASCII.GetBytes(":$Token")
)

$Headers = @{
    Authorization  = "Basic $Auth"
    "Content-Type" = "application/json"
}

Write-Host ""
Write-Host "======================================================"
Write-Host " $EnvironmentName -> $TargetBranch EXACT SYNC"
Write-Host "======================================================"
Write-Host "Build ID            : $BuildId"
Write-Host "Deployed Source SHA : $DeployedSHA"
Write-Host "Target Branch       : $TargetBranch"
Write-Host ""

# ============================================================
# STEP 1 - GET APPLICATION REPOSITORY FROM BUILD
# ============================================================

Write-Host "STEP 1 - Getting repository from build..."

$BuildApi = "https://dev.azure.com/$Org/$Project/_apis/build/builds/$BuildId?api-version=7.1"

try {
    $BuildInfo = Invoke-RestMethod `
        -Uri $BuildApi `
        -Method GET `
        -Headers $Headers
}
catch {
    throw "Unable to retrieve build $BuildId. $($_.Exception.Message)"
}

$RepoName = $BuildInfo.repository.name
$RepoId   = $BuildInfo.repository.id
$RepoType = $BuildInfo.repository.type

if ([string]::IsNullOrWhiteSpace($RepoName)) {
    throw "Repository name could not be determined."
}

if ([string]::IsNullOrWhiteSpace($RepoId)) {
    throw "Repository ID could not be determined."
}

if ($RepoType -ne "TfsGit") {
    throw "Unexpected repository type '$RepoType'. Expected 'TfsGit'."
}

Write-Host "Repository Name : $RepoName"
Write-Host "Repository ID   : $RepoId"
Write-Host ""

# ------------------------------------------------------------
# REPOSITORY URL
# ------------------------------------------------------------

$RepoUrl = "https://dev.azure.com/$Org/$Project/_git/$RepoName"

# ------------------------------------------------------------
# LOCK / UNLOCK API
# ------------------------------------------------------------

$LockApi = "https://dev.azure.com/$Org/$Project/_apis/git/repositories/$RepoId/refs?filter=heads/$TargetBranch&api-version=7.1"

# ------------------------------------------------------------
# TEMP FOLDER
# ------------------------------------------------------------

$SafeRepoName = $RepoName -replace '[^a-zA-Z0-9._-]', '_'

$TempFolder = Join-Path `
    $AgentTemp `
    "DevCodeSync_${SafeRepoName}_$([guid]::NewGuid().ToString('N'))"

Write-Host "Temporary clone:"
Write-Host "  $TempFolder"
Write-Host ""

$LocationChanged = $false
$BranchUnlocked = $false

try {

    # ========================================================
    # STEP 2 - CLONE APPLICATION REPO
    # ========================================================

    Write-Host "STEP 2 - Cloning application repository..."

    git `
        -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
        clone `
        --quiet `
        --no-checkout `
        $RepoUrl `
        $TempFolder

    if ($LASTEXITCODE -ne 0) {
        throw "Repository clone failed for '$RepoName'."
    }

    Push-Location $TempFolder
    $LocationChanged = $true

    # ========================================================
    # STEP 3 - FETCH REFS AND TAGS
    # ========================================================

    Write-Host "STEP 3 - Fetching refs and tags..."

    git `
        -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
        fetch `
        origin `
        --prune `
        --tags `
        --force `
        --quiet

    if ($LASTEXITCODE -ne 0) {
        throw "Git fetch failed."
    }

    # ========================================================
    # STEP 4 - VERIFY TARGET BRANCH EXISTS
    # ========================================================

    Write-Host "STEP 4 - Verifying '$TargetBranch' exists..."

    git rev-parse `
        --verify `
        "refs/remotes/origin/$TargetBranch" *> $null

    if ($LASTEXITCODE -ne 0) {
        throw "Remote branch '$TargetBranch' does not exist."
    }

    # ========================================================
    # STEP 5 - VERIFY DEPLOYED COMMIT EXISTS
    # ========================================================

    Write-Host "STEP 5 - Verifying deployed commit..."

    git cat-file `
        -e `
        "$DeployedSHA^{commit}" 2>$null

    if ($LASTEXITCODE -ne 0) {

        Write-Host "Commit not present locally. Attempting exact SHA fetch..."

        git `
            -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
            fetch `
            origin `
            $DeployedSHA `
            --quiet

        if ($LASTEXITCODE -ne 0) {
            throw "Unable to fetch deployed commit '$DeployedSHA'."
        }

        git cat-file `
            -e `
            "$DeployedSHA^{commit}" 2>$null

        if ($LASTEXITCODE -ne 0) {
            throw "Deployed SHA '$DeployedSHA' is not available as a Git commit."
        }
    }

    $DeployedFullSHA = (
        git rev-parse "$DeployedSHA^{commit}"
    ).Trim()

    Write-Host "Resolved deployed SHA : $DeployedFullSHA"

    # ========================================================
    # STEP 6 - CURRENT Dev_Code SHA
    # ========================================================

    $CurrentBranchSHA = (
        git rev-parse "refs/remotes/origin/$TargetBranch"
    ).Trim()

    Write-Host "Current $TargetBranch : $CurrentBranchSHA"
    Write-Host "Deployed DEV commit   : $DeployedFullSHA"

    # ========================================================
    # STEP 7 - NO CHANGE NEEDED
    # ========================================================

    if ($CurrentBranchSHA -eq $DeployedFullSHA) {

        Write-Host ""
        Write-Host "NO CHANGE REQUIRED."
        Write-Host "$TargetBranch already matches deployed DEV exactly."

        return
    }

    # ========================================================
    # STEP 8 - DIRECTION
    # ========================================================

    Write-Host "STEP 8 - Determining direction..."

    git merge-base `
        --is-ancestor `
        $CurrentBranchSHA `
        $DeployedFullSHA

    if ($LASTEXITCODE -eq 0) {
        Write-Host "Direction: FORWARD"
    }
    else {

        git merge-base `
            --is-ancestor `
            $DeployedFullSHA `
            $CurrentBranchSHA

        if ($LASTEXITCODE -eq 0) {
            Write-Host "Direction: ROLLBACK / OLDER DEPLOYMENT"
        }
        else {
            Write-Host "Direction: DIVERGED HISTORY"
        }
    }

    # ========================================================
    # STEP 9 - UNLOCK TARGET BRANCH
    # ========================================================

    Write-Host "STEP 9 - Unlocking '$TargetBranch'..."

    $UnlockBody = @{
        isLocked = $false
    } | ConvertTo-Json

    try {
        $UnlockResult = Invoke-RestMethod `
            -Uri $LockApi `
            -Method PATCH `
            -Headers $Headers `
            -Body $UnlockBody
    }
    catch {
        throw "Unable to unlock '$TargetBranch'. $($_.Exception.Message)"
    }

    if ($UnlockResult.isLocked -eq $true) {
        throw "'$TargetBranch' still reports as locked."
    }

    $BranchUnlocked = $true

    Write-Host "$TargetBranch unlocked."

    # ========================================================
    # STEP 10 - REFRESH TARGET BRANCH
    # ========================================================

    Write-Host "STEP 10 - Refreshing '$TargetBranch'..."

    git `
        -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
        fetch `
        origin `
        "+refs/heads/${TargetBranch}:refs/remotes/origin/$TargetBranch" `
        --quiet

    if ($LASTEXITCODE -ne 0) {
        throw "Unable to refresh '$TargetBranch'."
    }

    $CurrentBranchSHA = (
        git rev-parse "refs/remotes/origin/$TargetBranch"
    ).Trim()

    Write-Host "$TargetBranch immediately before sync:"
    Write-Host "  $CurrentBranchSHA"

    # ========================================================
    # STEP 11 - EXACT SYNCHRONIZATION
    # ========================================================

    Write-Host "STEP 11 - Synchronizing '$TargetBranch'..."

    Write-Host "Current SHA:"
    Write-Host "  $CurrentBranchSHA"

    Write-Host "Deployed DEV SHA:"
    Write-Host "  $DeployedFullSHA"

    git `
        -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
        push `
        "--force-with-lease=refs/heads/${TargetBranch}:$CurrentBranchSHA" `
        origin `
        "${DeployedFullSHA}:refs/heads/$TargetBranch"

    if ($LASTEXITCODE -ne 0) {
        throw @"
$TargetBranch synchronization FAILED.

Possible causes:
1. Build Service does not have Force push.
2. Build Service does not have Bypass policies when pushing.
3. $TargetBranch changed after final fetch.
4. Branch was not actually unlocked.
5. Authentication failed.
"@
    }

    # ========================================================
    # STEP 12 - VERIFY REMOTE BRANCH
    # ========================================================

    Write-Host "STEP 12 - Verifying remote '$TargetBranch'..."

    $RemoteBranchLine = git `
        -c "http.extraheader=AUTHORIZATION: Basic $Auth" `
        ls-remote `
        --heads `
        origin `
        "refs/heads/$TargetBranch"

    if ([string]::IsNullOrWhiteSpace($RemoteBranchLine)) {
        throw "Unable to retrieve remote '$TargetBranch'."
    }

    $RemoteBranchSHA = (
        $RemoteBranchLine -split '\s+'
    )[0].Trim()

    Write-Host "Deployed DEV SHA : $DeployedFullSHA"
    Write-Host "$TargetBranch SHA : $RemoteBranchSHA"

    if ($RemoteBranchSHA -ne $DeployedFullSHA) {
        throw @"
CRITICAL VERIFICATION FAILURE.

$TargetBranch does not match deployed DEV.

Deployed:
$DeployedFullSHA

Remote:
$RemoteBranchSHA
"@
    }

    # ========================================================
    # STEP 13 - VERIFY TREE
    # ========================================================

    Write-Host "STEP 13 - Verifying exact Git tree..."

    $DeployedTreeSHA = (
        git rev-parse "$DeployedFullSHA^{tree}"
    ).Trim()

    $BranchTreeSHA = (
        git rev-parse "$RemoteBranchSHA^{tree}"
    ).Trim()

    Write-Host "Deployed tree      : $DeployedTreeSHA"
    Write-Host "$TargetBranch tree : $BranchTreeSHA"

    if ($DeployedTreeSHA -ne $BranchTreeSHA) {
        throw "$TargetBranch tree does not match the deployed DEV tree."
    }

    Write-Host "Commit verification : PASSED"
    Write-Host "Tree verification   : PASSED"

    # ========================================================
    # STEP 14 - LOCK TARGET BRANCH
    # ========================================================

    Write-Host "STEP 14 - Locking '$TargetBranch' again..."

    $LockBody = @{
        isLocked = $true
    } | ConvertTo-Json

    try {
        $LockResult = Invoke-RestMethod `
            -Uri $LockApi `
            -Method PATCH `
            -Headers $Headers `
            -Body $LockBody
    }
    catch {
        throw @"
Synchronization succeeded, but '$TargetBranch'
could not be locked again.

Repository:
$RepoName

SHA:
$RemoteBranchSHA

Error:
$($_.Exception.Message)
"@
    }

    if ($LockResult.isLocked -ne $true) {
        throw "Azure DevOps did not confirm '$TargetBranch' was locked."
    }

    $BranchUnlocked = $false

    Write-Host ""
    Write-Host "======================================================"
    Write-Host " SUCCESS"
    Write-Host "======================================================"
    Write-Host "Repository          : $RepoName"
    Write-Host "Environment         : $EnvironmentName"
    Write-Host "Deployed SHA        : $DeployedFullSHA"
    Write-Host "$TargetBranch SHA   : $RemoteBranchSHA"
    Write-Host ""
    Write-Host "VERIFIED:"
    Write-Host "  $TargetBranch SHA  == deployed DEV SHA"
    Write-Host "  $TargetBranch tree == deployed DEV tree"
    Write-Host "  $TargetBranch is locked"
}
catch {

    Write-Host ""
    Write-Host "======================================================"
    Write-Host " ERROR"
    Write-Host "======================================================"
    Write-Host $_.Exception.Message

    if ($BranchUnlocked) {

        Write-Host ""
        Write-Host "Attempting emergency re-lock of '$TargetBranch'..."

        try {

            $EmergencyLockBody = @{
                isLocked = $true
            } | ConvertTo-Json

            $EmergencyResult = Invoke-RestMethod `
                -Uri $LockApi `
                -Method PATCH `
                -Headers $Headers `
                -Body $EmergencyLockBody

            if ($EmergencyResult.isLocked -eq $true) {
                $BranchUnlocked = $false
                Write-Host "Emergency re-lock succeeded."
            }
            else {
                Write-Host "WARNING: Azure DevOps did not confirm the branch lock."
            }
        }
        catch {

            Write-Host ""
            Write-Host "CRITICAL WARNING:"
            Write-Host "'$TargetBranch' could not be automatically re-locked."
            Write-Host "Repository: $RepoName"
            Write-Host "Manual intervention is required."
        }
    }

    exit 1
}
finally {

    if ($LocationChanged) {
        try {
            Pop-Location
        }
        catch {
        }
    }

    if (
        -not [string]::IsNullOrWhiteSpace($TempFolder) -and
        (Test-Path $TempFolder)
    ) {

        Write-Host ""
        Write-Host "Cleaning temporary clone:"
        Write-Host "  $TempFolder"

        Remove-Item `
            $TempFolder `
            -Recurse `
            -Force `
            -ErrorAction SilentlyContinue
    }
}
